#!/usr/bin/env python3
"""vl-release launcher.

Works installed (/usr/bin, Homebrew libexec) and from a source checkout: when a `vlrelease`
package sits next to this script's `bin/` directory, that copy is used. A broken installed
package can therefore always be bypassed with `<checkout>/bin/vlr` or `python3 -m vlrelease`.
"""

import os
import sys

_checkout = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isfile(os.path.join(_checkout, "vlrelease", "__init__.py")):
    sys.path.insert(0, _checkout)

from vlrelease.cli import main  # noqa: E402

sys.exit(main())
